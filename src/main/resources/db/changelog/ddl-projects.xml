<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="001-create-projects-banner" author="faguiar">
        <createTable tableName="projects_banner">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="subtitle" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-project" author="faguiar">
        <createTable tableName="project">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="subtitle" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="location" type="VARCHAR(255)"/>

            <column name="year" type="INT"/>
            <column name="total_area" type="INT"/>
            <column name="duration" type="INT"/>
            <column name="duration_unit" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-project-image" author="faguiar">
        <createTable tableName="project_image">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="project_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- New column to reference actual image data -->
            <column name="project_image_data_id" type="UUID">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="project_image"
                baseColumnNames="project_id"
                referencedTableName="project"
                referencedColumnNames="id"
                constraintName="fk_project_image_project"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="project_image"
                baseColumnNames="project_image_data_id"
                referencedTableName="image"
                referencedColumnNames="id"
                constraintName="fk_project_image_image_data"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>